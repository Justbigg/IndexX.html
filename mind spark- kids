<div id="toast" role="status" aria-live="polite"></div>

<script>
const questions = [
  {
    q:"Which planet is known as the Red Planet?",
    a:["🌍 Earth","🔴 Mars","🪐 Saturn","🌞 Sun"],
    correct:1,
    explanation:"Mars is called the Red Planet because of iron-rich dust on its surface."
  },
  {
    q:"How many legs does a spider have?",
    a:["4 legs","6 legs","8 legs","10 legs"],
    correct:2,
    explanation:"A spider has eight legs!"
  },
  {
    q:"What do plants need to make their own food?",
    a:["Sunlight","Plastic","Sand only","Darkness"],
    correct:0,
    explanation:"Plants use sunlight, water and carbon dioxide in photosynthesis."
  }
];

let questionIndex=0;
let points=0;
let answered=false;
let timer=null;

function toggleMenu(){
  document.getElementById("navLinks").classList.toggle("open");
}

document.querySelectorAll(".nav-links a").forEach(link=>{
  link.addEventListener("click",()=>{
    document.getElementById("navLinks").classList.remove("open");
  });
});

function startLesson(){
  clearInterval(timer);
  let remaining=35;
  const status=document.getElementById("lessonStatus");
  status.textContent="Lesson demonstration: "+remaining+" seconds remaining";
  timer=setInterval(()=>{
    remaining--;
    status.textContent="Lesson demonstration: "+remaining+" seconds remaining";
    if(remaining<=0){
      clearInterval(timer);
      status.textContent="Lesson complete! Now test what you remember. ⭐";
      showToast("Great job! Time for a memory challenge.");
    }
  },1000);
}

function renderQuestion(){
  const q=questions[questionIndex];
  answered=false;
  document.getElementById("question").textContent=q.q;
  document.getElementById("feedback").textContent="";
  document.getElementById("nextQuestion").style.display="none";
  document.getElementById("quizProgress").style.width=((questionIndex+1)/questions.length*100)+"%";
  document.querySelector("#demo strong").textContent="Question "+(questionIndex+1)+" of "+questions.length;
  document.getElementById("answers").innerHTML=q.a.map((a,i)=>
    `<button class="answer" onclick="checkAnswer(${i})">${a}</button>`
  ).join("");
}

function checkAnswer(index){
  if(answered)return;
  answered=true;
  const q=questions[questionIndex];
  const buttons=document.querySelectorAll(".answer");
  buttons.forEach((button,i)=>{
    button.disabled=true;
    if(i===q.correct)button.classList.add("correct");
    if(i===index && i!==q.correct)button.classList.add("wrong");
  });
  const feedback=document.getElementById("feedback");
  if(index===q.correct){
    points+=10;
    feedback.textContent="🎉 Correct! +10 points. "+q.explanation;
    feedback.style.color="#22a879";
  }else{
    feedback.textContent="Good try! "+q.explanation;
    feedback.style.color="#e27b65";
  }
  document.getElementById("score").textContent="⭐ "+points+" points";
  const next=document.getElementById("nextQuestion");
  next.style.display="inline-flex";
  next.textContent=questionIndex===questions.length-1?"See Results →":"Next Challenge →";
}

function nextQuestion(){
  questionIndex++;
  if(questionIndex>=questions.length){
    document.getElementById("question").textContent="Challenge Complete! 🏆";
    document.getElementById("answers").innerHTML=
      "<p>You earned "+points+" points out of 30. Great effort!</p>";
    document.getElementById("feedback").textContent="Remember: practicing again later helps strengthen recall.";
    document.getElementById("nextQuestion").textContent="Play Again";
    document.getElementById("nextQuestion").onclick=resetQuiz;
    return;
  }
  renderQuestion();
}

function resetQuiz(){
  questionIndex=0;
  points=0;
  document.getElementById("score").textContent="⭐ 0 points";
  document.getElementById("nextQuestion").onclick=nextQuestion;
  renderQuestion();
}

function openModal(type){
  const modal=document.getElementById("modal");
  const title=document.getElementById("modalTitle");
  const desc=document.getElementById("modalDescription");
  const interest=document.getElementById("interest");
  if(type==="advertiser"){
    title.textContent="Become a MindSpark Partner";
    desc.textContent="Tell us about your business and sponsorship interests.";
    interest.value="Advertising sponsorship";
  }else{
    title.textContent="Join MindSpark Kids!";
    desc.textContent="Start your family's learning adventure.";
    interest.value="Family learning membership";
  }
  modal.classList.add("active");
}

function closeModal(){
  document.getElementById("modal").classList.remove("active");
}

function selectPlan(plan){
  showToast(plan+" selected. Payment integration is required to activate subscriptions.");
}

function showToast(message){
  const toast=document.getElementById("toast");
  toast.textContent=message;
  toast.style.display="block";
  clearTimeout(window.toastTimer);
  window.toastTimer=setTimeout(()=>toast.style.display="none",3500);
}

document.getElementById("demoForm").addEventListener("submit",function(e){
  e.preventDefault();
  showToast("Demo received locally. Connect a secure backend to process registrations.");
  this.reset();
  closeModal();
});

document.getElementById("modal").addEventListener("click",function(e){
  if(e.target===this)closeModal();
});

document.getElementById("year").textContent=new Date().getFullYear();
renderQuestion();
</script>

